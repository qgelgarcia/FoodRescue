{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build --workspace=@foodrescue/frontend",
  "outputDirectory": "apps/frontend/dist",
  "installCommand": "npm ci --include=dev --ignore-scripts",
  "functions": { "api/[...path].ts": { "maxDuration": 120 } },
  "rewrites": [{ "source": "/((?!api(?:/|$)|assets/).*)", "destination": "/index.html" }]
}
