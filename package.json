{
  "name": "foodrescue-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=@foodrescue/frontend",
    "dev:backend": "npm run dev --workspace=@foodrescue/backend",
    "build": "npm run build:shared && npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=@foodrescue/frontend",
    "build:backend": "npm run build --workspace=@foodrescue/backend",
    "build:shared": "npm run build --workspace=@foodrescue/shared",
    "start:backend": "npm run start --workspace=@foodrescue/backend",
    "preview:frontend": "npm run preview --workspace=@foodrescue/frontend",
    "db:push": "npx supabase db push",
    "db:diff": "npx supabase db diff",
    "db:new-migration": "npx supabase migration new"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
