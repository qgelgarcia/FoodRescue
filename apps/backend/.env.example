PORT=5000
NODE_ENV=development

# Supabase configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Client URL for CORS
CLIENT_URL=http://127.0.0.1:5173,http://127.0.0.1:5175,http://localhost:5175

# Server only. Never prefix this key with VITE_ or commit a real value.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Email delivery is opt-in for this deployment. Set true only after sender verification.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_USER=your-sender@gmail.com
SMTP_PASS=
# Optional alternative: EMAIL_PROVIDER=resend and a verified-domain EMAIL_FROM
RESEND_API_KEY=
EMAIL_FROM=
APP_PUBLIC_URL=http://127.0.0.1:5175

# Generated server-only shared secret for the protected cloud scheduler endpoint.
EMAIL_DISPATCH_SECRET=
